# 1. Sepolia RPC Provider URL
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"

# 2. Deployer Wallet Private Key (without '0x' prefix)
PRIVATE_KEY="your_deployer_private_key_here"

# 3. Mock TEE Agent Wallet Private Key (without '0x' prefix)
AGENT_PRIVATE_KEY="your_agent_private_key_here"

# 4. Etherscan API Key (for contract source verification)
ETHERSCAN_API_KEY="your_etherscan_api_key_here"